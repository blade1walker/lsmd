generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Section {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
}

model Member {
  id             String   @id @default(cuid())
  order          Int      @default(0)
  name           String
  dept           String   @default("LSMD")
  rank           String
  stateId        String?
  steamId        String?
  position       String?
  callSign       String?
  activity       String   @default("Active")
  ptd            Boolean  @default(false)
  hr             Boolean  @default(false)
  asd            Boolean  @default(false)
  bike           Boolean  @default(false)
  speedUnit      Boolean  @default(false)
  timezone       String?
  dateOfJoining  DateTime?
  lastPromotion  DateTime?
  discordId      String?
  ftoRole        String?
  tempRank       String?
  category       String?
  sectionId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  section            Section?            @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  clockEntries       ClockEntry[]
  trainingRecord     TrainingRecord?
  loas               LOA[]
  inactivityRequests InactivityRequest[]
  removalRequests    RemovalRequest[]
  ftoSignOffRecords  FTOSignOffRecord[]
  departmentMemberships DepartmentMembership[]
  shiftSignup        ShiftSignup?
  /** Medical documents naming this member as the patient. */
  medicalDocuments   MedicalDocument[]
  /** EMS calls this member responded to. */
  callResponses      EmsCallResponder[]
}

model ClockEntry {
  id          String   @id @default(cuid())
  memberId    String
  clockInAt   DateTime @default(now())
  clockOutAt  DateTime?
  durationSec Int?
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// Superseded by SopDocument, which supports more than one SOP. Kept rather
// than dropped so `db push` does not destroy the content a live database
// still holds — scripts/migrate-sop.ts copies it into SopDocument.
model SopContent {
  id        String   @id @default("sop-main")
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SopDocument {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  order     Int      @default(0)
  /** [{ "label": string, "url": string }] — shown below the document content. */
  relatedLinks Json   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingRecord {
  id       String @id @default(cuid())
  memberId String @unique

  cadetPhase1COC           Boolean @default(false)
  cadetPhase1COCCby        String?
  cadetPhase1PCRS          Boolean @default(false)
  cadetPhase1PCRSby        String?
  cadetPhase1UoF           Boolean @default(false)
  cadetPhase1UoFby         String?
  cadetPhase1Situation     Boolean @default(false)
  cadetPhase1Situationby   String?

  cadetPhase2Legal            Boolean @default(false)
  cadetPhase2Legalby          String?
  cadetPhase2Constitution     Boolean @default(false)
  cadetPhase2Constitutionby   String?
  cadetPhase2Radio            Boolean @default(false)
  cadetPhase2Radioby          String?
  cadetPhase2Report           Boolean @default(false)
  cadetPhase2Reportby         String?

  cadetPhase3Negotiation      Boolean @default(false)
  cadetPhase3Negotiationby    String?
  cadetPhase3Hostage          Boolean @default(false)
  cadetPhase3Hostageby        String?
  cadetPhase3Traffic          Boolean @default(false)
  cadetPhase3Trafficby        String?
  cadetPhase3Ticket           Boolean @default(false)
  cadetPhase3Ticketby         String?
  cadetPhase3Pursuit          Boolean @default(false)
  cadetPhase3Pursuitby        String?

  probationaryReportNumber        String  @default("")
  probationaryTrafficStops        Int     @default(0)
  probationaryMDTReports          Int     @default(0)
  probationaryNegotiation         Boolean @default(false)
  probationaryNegotiationby       String?
  probationaryCommunication       Boolean @default(false)
  probationaryCommunicationby     String?
  probationaryRecommendation      Boolean @default(false)
  probationaryRecommendationby    String?
  probationaryTheory              Boolean @default(false)
  probationaryTheoryby            String?
  probationaryPractical           Boolean @default(false)
  probationaryPracticalby         String?
  probationaryStatus              String  @default("")

  phase2Signoff   Boolean    @default(false)
  phase2SignedBy  String?
  phase2SignedAt  DateTime?
  phase3Signoff   Boolean    @default(false)
  phase3SignedBy  String?
  phase3SignedAt  DateTime?

  /**
   * EMS training progress: { checkpoints: { [key]: { by, at } }, counters: { [key]: n } },
   * keyed by the curriculum in src/lib/training.ts.
   *
   * Every cadetPhase* and probationary* column above is a police academy topic
   * inherited from the PD roster (Use of Force, Hostage Handling, Traffic
   * Stops...). They are left in place and unread rather than relabelled or
   * dropped: relabelling would silently re-assign every existing tick to a
   * different skill, and dropping would destroy it.
   */
  emsProgress     Json       @default("{}")

  member  Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  remarks Remark[]
}

model LOA {
  id        String   @id @default(cuid())
  memberId  String
  reason    String
  startDate DateTime
  endDate   DateTime
  status    String   @default("Active")
  notes     String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model InactivityRequest {
  id          String   @id @default(cuid())
  memberId    String
  submittedBy String
  reason      String
  status      String   @default("Pending")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model PromotionNotification {
  id         String   @id @default(cuid())
  memberId   String?
  memberName String
  callSign   String?
  fromRank   String
  toRank     String
  promotedBy String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AdminRole {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions String[]
  // Position in the reorderable hierarchy — lower value ranks higher, same
  // convention as Section.order/SopDocument.order elsewhere in this schema.
  // A role's effective permissions include its own plus every role ranked
  // at or below it, so a permission on a lower role is automatically held by
  // every role above it. autoincrement() rather than a fixed default so
  // existing rows get distinct values when this column is added — a shared
  // default would tie every role at the same rank and cascade them all into
  // each other, which is a real permission escalation, not a display glitch.
  order       Int          @default(autoincrement())
  // Legacy single-role assignment. Kept rather than replaced so existing
  // assignments are not silently dropped — resolveAccess() unions this with
  // the new multi-role relation below, so either one alone still works.
  adminUsers  AdminUser[]
  assignedTo  AdminUser[] @relation("AdminUserRoles")
}

model TempRankTemplate {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)
}

model CategoryTemplate {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#eab308")
  order Int    @default(0)
}

/**
 * A named department a roster Member can belong to (Member.dept is a plain
 * string, matched by name — not a foreign key, so existing values like the
 * "LSMD" default keep working without a migration). documentLink is one
 * link an admin can attach — SOPs, a roster doc, whatever that department
 * wants pinned.
 *
 * A department is also a join-application form: `questions` are what the
 * public form asks, `applications` are what came back, and `memberships` are
 * who got in. Its name doubles as the roster tag — the same way "FTP" was
 * hard-coded before departments could be created freely.
 */
model DepartmentTemplate {
  id           String  @id @default(cuid())
  name         String  @unique
  documentLink String?
  order        Int     @default(0)
  /** Short label for the roster column header and the member tag. Falls back to `name`. */
  tag          String?
  /** Tag and tick colour on the roster. */
  color        String  @default("#dc2626")
  /** Blurb shown above the join form. */
  description  String?
  /** Where a submitted application is posted. Falls back to the shared "department" webhook. */
  webhookUrl   String?
  /** Whether the public join form accepts new applications. */
  openForApplications Boolean @default(true)
  /** Optional rank gate, by RANKS name. Null means every rank may apply. */
  minRank      String?
  /** Guild role granted on approval — inert until set (see lib/discord-roles). */
  discordRoleId String?

  questions    DepartmentQuestion[]
  applications DepartmentApplication[]
  memberships  DepartmentMembership[]
}

/**
 * One question on a department's join form. Admin-authored, so each form asks
 * whatever that department needs rather than the single fixed "previous
 * experience" box the FTP form had.
 */
model DepartmentQuestion {
  id           String  @id @default(cuid())
  departmentId String
  label        String
  /** "text" | "textarea" | "select" | "checkbox" */
  type         String  @default("textarea")
  /** [string] — the choices, for a "select" question. */
  options      Json    @default("[]")
  placeholder  String?
  /** Mandatory questions block submission until answered. */
  required     Boolean @default(false)
  order        Int     @default(0)

  department   DepartmentTemplate @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

/**
 * A submitted join request. Answers are snapshotted with their label, not just
 * their questionId, so editing or deleting a question later does not rewrite
 * what an applicant was actually asked.
 */
model DepartmentApplication {
  id            String   @id @default(cuid())
  departmentId  String
  memberId      String?
  characterName String
  discordId     String
  currentRank   String
  /** [{ "questionId": string, "label": string, "answer": string }] */
  answers       Json     @default("[]")
  status        String   @default("Pending")
  reviewedBy    String?
  reviewNote    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department    DepartmentTemplate @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId, status])
  @@index([createdAt])
}

/**
 * Who is in a department and at what standing. Separate from Member.dept
 * (which holds one primary department name) because a member can sit in
 * several departments at once — that is what the roster tick columns show.
 */
model DepartmentMembership {
  id           String   @id @default(cuid())
  departmentId String
  memberId     String
  /** One of DEPARTMENT_ROLES: "High Command" | "Command" | "Lead" | "Member". */
  role         String   @default("Member")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   DepartmentTemplate @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  member       Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([departmentId, memberId])
  @@index([memberId])
}

/**
 * One member's standing shift pick. A member's whole submission is a single
 * row keyed on their id — resubmitting overwrites it rather than piling up
 * history, since only the current pick matters for the schedule.
 *
 * primarySlot/secondarySlot are indexes into SHIFT_SLOTS (lib/shifts.ts):
 * 0 = 12:00 AM-2:00 AM, 1 = 2:00 AM-4:00 AM, ... 11 = 10:00 PM-12:00 AM.
 */
model ShiftSignup {
  memberId      String   @id
  primarySlot   Int
  secondarySlot Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id          String    @id @default(cuid())
  discordId   String    @unique
  discordName String
  // Legacy single role. New assignments use `roles` below; this stays so a
  // user assigned before the multi-role UI shipped keeps their access.
  roleId      String?
  role        AdminRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roles       AdminRole[] @relation("AdminUserRoles")
  // Individual permission grants outside of any role — for the rare person
  // who needs one extra permission without a whole role built around them.
  // Additive only: this can grant beyond what their role(s) allow, never
  // revoke a permission a role already grants.
  extraPermissions String[] @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model RemovalRequest {
  id              String   @id @default(cuid())
  memberId        String
  memberName      String
  memberRank      String
  requestedBy     String
  reason          String
  status          String   @default("Pending")
  reviewedBy      String?
  reviewNote      String?
  isPTDCase       Boolean  @default(false)
  ptdReviewStatus String?
  ptdReviewedBy   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model RadioCode {
  id          String   @id @default(cuid())
  code        String
  description String
  section     String   @default("ten")
  order       Int      @default(0)
  highlighted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SignOffDefinition {
  id            String           @id @default(cuid())
  name          String
  order         Int              @default(0)
  status        String           @default("Active")
  pendingName   String?
  pendingAction String?
  createdBy     String?
  approvedBy    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  records       FTOSignOffRecord[]
}

model FTOSignOffRecord {
  id                  String            @id @default(cuid())
  ftoMemberId         String
  signOffDefinitionId String
  completedAt         DateTime          @default(now())
  completedBy         String?
  notes               String?
  ftoMember           Member            @relation(fields: [ftoMemberId], references: [id], onDelete: Cascade)
  signOffDefinition   SignOffDefinition @relation(fields: [signOffDefinitionId], references: [id], onDelete: Cascade)
}

model Remark {
  id               String         @id @default(cuid())
  trainingRecordId String
  authorCallSign   String?
  authorRole       String?
  content          String
  createdAt        DateTime       @default(now())
  trainingRecord   TrainingRecord @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
}

model DeletionLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  entityLabel String
  data        Json
  deletedBy   String
  deletedAt   DateTime @default(now())
  expiresAt   DateTime
}

model OnboardingRequest {
  id          String   @id @default(cuid())
  name        String
  discordId   String
  stateId     String?
  steamId     String?
  reason      String?
  status      String   @default("Pending")
  assignedRank String?
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FTPRequest {
  id                String   @id @default(cuid())
  characterName     String
  discordId         String
  currentRole       String
  previousExperience String
  department        String
  status            String   @default("Pending")
  reviewedBy        String?
  reviewNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RecruitRequest {
  id              String   @id @default(cuid())
  discordId       String
  discordUsername String?
  steamId         String
  characterName   String?
  user            String?
  status          String   @default("Pending")
  rank            String?
  reviewedBy      String?
  reviewNote      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NotificationSettings {
  id                   String  @id @default("singleton")
  recruitWebhook       Boolean @default(true)
  recruitDM            Boolean @default(true)
  recruitWebhookApprove String @default("Congratulations! Your EMS application has been Accepted, <@{discordId}> For further details, please check your DMs")
  recruitWebhookDecline String @default("Unfortunately, your EMS application has been Declined, <@{discordId}> For further details, please check your DMs")
  recruitDMApprove     String @default("Congratulations, {name}! 🎉\n\nYour recruitment application has been **Accepted**!\n\n**Assigned Rank:** {rank}\n\nJoin our state Discord server to get started:\n{inviteLink}\n\nWelcome aboard! 🚑🚀")
  recruitDMDecline     String @default("Dear {name},\n\nWe regret to inform you that your recruitment application has been **Declined**.\n\nIf you have questions, please contact HR.")
  onboardingWebhook    Boolean @default(false)
  onboardingDM         Boolean @default(true)
  onboardingWebhookMessage String @default("<@{discordId}> **{name}** has been enrolled in the EMS roster.")
  onboardingDMApprove  String @default("Congratulations, {name}! 🎉\n\nYou have been accepted into the Emergency Medical Services!\n\n**Your Details:**\n• Rank: {rank}\n• Call Sign: {callSign}\n• State ID: {stateId}\n\nJoin our state Discord server to get started:\n{inviteLink}\n\nWelcome aboard! 🚑🚀")
  onboardingDMDecline  String @default("Dear {name},\n\nWe regret to inform you that your application has been **Declined**.\n\nIf you have questions, please contact HR.")
  ftpWebhook           Boolean @default(false)
  ftpDM                Boolean @default(true)
  ftpDMApprove         String @default("Congratulations, {name}! 🎉\n\nYour Field Training Program (FTP) application has been **Accepted**! You have been assigned the FTP role and a trainer will reach out to you shortly.\n\nJoin our state Discord server:\n{inviteLink}")
  ftpDMDecline         String @default("Dear {name},\n\nYour Field Training Program (FTP) application has been **Declined**.\n\nIf you have questions, please contact HR.")
  ftpWebhookApprove    String @default("🎓 {name} ({callSign}) has enrolled in the Field Training Program!")
  departmentWebhook          Boolean @default(true)
  departmentDM               Boolean @default(true)
  departmentWebhookSubmitted String  @default("📥 **{department}** — new join application from **{name}** ({rank}) <@{discordId}>")
  departmentWebhookApprove   String  @default("✅ <@{discordId}> **{name}** has joined **{department}**.")
  departmentWebhookDecline   String  @default("❌ **{name}**'s application to **{department}** has been declined.")
  departmentDMApprove        String  @default("Congratulations, {name}! 🎉\n\nYour application to join **{department}** has been **Accepted**.\n\nWelcome to the team!")
  departmentDMDecline        String  @default("Dear {name},\n\nYour application to join **{department}** has been **Declined**.\n\nIf you have questions, please contact HR.")
  loaWebhook           Boolean @default(true)
  loaDM                Boolean @default(false)
  loaWebhookApprove    String @default("<@{discordId}> **{name}** has been granted a Leave of Absence.")
  loaWebhookDecline    String @default("<@{discordId}> **{name}**'s Leave of Absence request has been declined.")
  loaDMApprove         String @default("Your Leave of Absence has been **Approved**.\n\nStart: {startDate}\nEnd: {endDate}\nReason: {reason}")
  loaDMDecline         String @default("Your Leave of Absence request has been **Declined**.\n\nIf you have questions, please contact HR.")
  loaReminderDM        Boolean @default(true)
  loaReminderMessage   String @default("Hi {name}, your Leave of Absence ends on {endDate} — {daysLeft} day(s) from now. Let HR know if you need an extension.")
  loaExpiredDM         Boolean @default(true)
  loaExpiredMessage    String @default("Welcome back, {name}! Your Leave of Absence ended on {endDate} and your roster status is Active again.")
  promotionWebhook        Boolean @default(true)
  promotionWebhookMessage String  @default("🎉 Congratulations <@{discordId}>! {name} ({callSign}) has been promoted from **{fromRank}** to **{toRank}**!")
  demotionWebhook         Boolean @default(false)
  demotionWebhookMessage  String  @default("📋 {name} ({callSign}) has been moved from **{fromRank}** to **{toRank}**.")
  callsignWebhook         Boolean @default(true)
  callsignWebhookMessage  String  @default("📻 <@{discordId}>'s call sign has been updated: **{oldCallSign}** → **{newCallSign}**")
  testWebhook          Boolean @default(true)
  testDM               Boolean @default(true)
  webhookUrls          Json?
  botSettings          Json?
}

/**
 * One row per notification attempt. Sends happen inside serverless requests
 * where a console.error goes nowhere, so a failed DM used to be invisible —
 * this is the record that answers "did that member actually get it?".
 */
model NotificationLog {
  id        String   @id @default(cuid())
  /** Dotted event name, e.g. "recruit.approved", "loa.reminder". */
  event     String
  /** "webhook" or "dm". */
  channel   String
  /** Discord user id for a DM, channel kind for a webhook. */
  target    String?
  ok        Boolean
  status    Int?
  error     String?
  /** First 300 characters of what was sent, for spotting a bad template. */
  preview   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  entityLabel String
  details     Json     @default("{}")
  performedBy String
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([createdAt])
}

/**
 * One DM conversation between the bot and a Discord user.
 *
 * NotificationLog answers "did that send succeed?" and is capped at a 300
 * character preview, so it can't show a conversation. This is the thread
 * itself: every DM the bot sends to this person, plus the replies pulled back
 * from Discord.
 */
model DMThread {
  id            String   @id @default(cuid())
  discordId     String   @unique
  /** Discord's DM channel id, cached so a sync need not reopen the channel. */
  channelId     String?
  /** Their Discord name at last sync, so the list reads as names not snowflakes. */
  username      String?
  /** Set when the Discord account matches a roster member. */
  memberId      String?
  memberName    String?
  lastMessageAt DateTime @default(now())
  /** Inbound messages after this are unread in the panel. */
  lastReadAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages      DirectMessage[]

  @@index([lastMessageAt])
}

model DirectMessage {
  id        String   @id @default(cuid())
  threadId  String
  /** "out" — bot to user; "in" — their reply, pulled back from Discord. */
  direction String
  content   String
  /**
   * Discord's own message id. Unique, so re-syncing a thread can never
   * duplicate a reply that is already stored.
   */
  discordMessageId String? @unique
  /** The automation that produced an outbound message, or "manual". */
  event     String   @default("manual")
  /** The panel user behind a manual send. */
  sentBy    String?
  ok        Boolean  @default(true)
  error     String?
  sentAt    DateTime @default(now())

  thread    DMThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt])
}

// ─── Medical Documentation ──────────────────────────────────────────────────
//
// A configurable documentation platform rather than a page per document. A
// document type names the kind of record, a form version defines the fields,
// and a medical document stores one doctor's answers against the exact
// version they filled in. Command adds a type, builds a form and publishes
// it; doctors can use it immediately, with no new code.

model MedicalDocumentType {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  /** Groups the type in the UI: Report, Certificate, Evaluation, Other. */
  category     String   @default("Report")
  /**
   * Leading segment of every document number issued under this type —
   * "EMS-MED" gives EMS-MED-2026-000124. Certificates usually get their own
   * so they number in their own series.
   */
  numberPrefix String   @default("EMS-MED")
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  forms     MedicalForm[]
  documents MedicalDocument[]
}

model MedicalForm {
  id             String    @id @default(cuid())
  name           String
  description    String?
  documentTypeId String
  /** Draft | Active | Inactive | Archived — only Active forms can be filled in. */
  status         String    @default("Draft")
  /** Free-text department, matching Member.dept, or null for all of EMS. */
  department     String?
  createdBy      String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  documentType MedicalDocumentType  @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  versions     MedicalFormVersion[]

  @@index([documentTypeId])
  @@index([status])
}

/**
 * One snapshot of a form's field set, treated as immutable once it leaves
 * draft.
 *
 * Editing a published version mints a new one instead of writing to it, so a
 * completed medical record always renders with exactly the fields the doctor
 * saw and answered. Changing a form must never alter history — that guarantee
 * is the whole reason versions are a table rather than a column.
 */
model MedicalFormVersion {
  id            String   @id @default(cuid())
  formId        String
  /** "1.0", "1.1", … shown beside the form name wherever it is offered. */
  version       String
  /** FormField[] — shape defined in src/lib/medical.ts. */
  fields        Json     @default("[]")
  /** ExportConfig — which sections and fields reach the PDF, and in what order. */
  exportConfig  Json     @default("{}")
  /** required | optional | disabled */
  signatureMode String   @default("optional")
  published     Boolean  @default(false)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  form      MedicalForm       @relation(fields: [formId], references: [id], onDelete: Cascade)
  documents MedicalDocument[]

  @@unique([formId, version])
  @@index([formId])
}

model MedicalDocument {
  id             String  @id @default(cuid())
  /**
   * EMS-MED-2026-000124. Null until the document is finalized — a draft has
   * no official number, and the number is what makes the record citable.
   */
  documentNumber String? @unique
  documentTypeId String
  formVersionId  String
  /** Draft | Review | Finalized | Archived */
  status         String  @default("Draft")

  /**
   * Linked to a roster Member when the patient is one, so their rank and call
   * sign can be pulled in — but a plain name and State ID otherwise, because
   * most patients are civilians who will never be on the EMS roster.
   */
  patientMemberId String?
  patientName     String
  patientStateId  String?

  /** Answers keyed by FormField.name. */
  answers Json @default("{}")

  authorDiscordId String
  authorName      String
  authorRank      String?

  signedBy    String?
  signedAt    DateTime?
  finalizedAt DateTime?
  finalizedBy String?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentType MedicalDocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  formVersion  MedicalFormVersion  @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  patient      Member?             @relation(fields: [patientMemberId], references: [id], onDelete: SetNull)
  attachments  MedicalAttachment[]

  @@index([status])
  @@index([patientMemberId])
  @@index([authorDiscordId])
  @@index([documentTypeId])
  @@index([createdAt])
}

model MedicalAttachment {
  id          String   @id @default(cuid())
  documentId  String
  /** The FormField.name this file was attached to. */
  fieldName   String
  fileName    String
  url         String
  contentType String
  size        Int
  uploadedBy  String?
  createdAt   DateTime @default(now())

  document MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

/**
 * The counter behind document numbers, one row per (prefix, year) so that
 * EMS-MED and EMS-CERT number independently and each year restarts at 1.
 * Incremented in a single atomic statement — two doctors finalizing at once
 * must never be handed the same number.
 */
model MedicalNumberSequence {
  id         String @id @default(cuid())
  prefix     String
  year       Int
  lastNumber Int    @default(0)

  @@unique([prefix, year])
}

/**
 * Department branding for exported documents — the letterhead every PDF is
 * printed on. One row; per-form layout choices live in the version's
 * exportConfig instead.
 */
model MedicalSettings {
  id                    String   @id @default("singleton")
  departmentName        String   @default("EMERGENCY MEDICAL SERVICES")
  subDepartment         String?
  logoUrl               String?
  address               String?
  contact               String?
  confidentialityNotice String   @default("CONFIDENTIAL MEDICAL RECORD — This document contains privileged medical information intended only for the named recipient.")
  disclaimer            String?

  /**
   * The secondary letterhead, printed directly beneath the main one — the
   * issuing facility or division under the department's own banner, rather
   * than a replacement for it.
   *
   * secondaryDetail is the extra block that closes it out: licence numbers,
   * accreditation, a registrar line — whatever the second band has to carry
   * that the department banner above it does not.
   */
  secondaryName    String?
  secondaryLogoUrl String?
  secondaryAddress String?
  secondaryContact String?
  secondaryDetail  String?

  updatedAt DateTime @updatedAt
}

/**
 * The spotlight strip across the public roster, under the hero — department
 * news or a shout-out. One row; inactive or empty means no strip is shown.
 */
model RosterBanner {
  id        String   @id @default("singleton")
  active    Boolean  @default(false)
  /** Bold leading label, e.g. "DEPARTMENT SPOTLIGHT". */
  label     String   @default("")
  /** The name or phrase set in the accent colour. */
  highlight String   @default("")
  message   String   @default("")
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ─── EMS Call Log ───────────────────────────────────────────────────────────

/**
 * One patient contact or EMS response: when and where, what it was, who went,
 * and how it ended. Quick to log from the field — the formal write-up is a
 * MedicalDocument, which a call can point at by its document number.
 */
model EmsCall {
  id                    String   @id @default(cuid())
  /** EMS-CALL-2026-000124, from the same per-prefix counter as document numbers. */
  callNumber            String   @unique
  occurredAt            DateTime
  location              String
  /** One of CALL_NATURES in src/lib/calls.ts. */
  nature                String
  /** P1 | P2 | P3 */
  priority              String   @default("P2")
  /** One of CALL_OUTCOMES. */
  outcome               String
  /** Receiving facility, set when the patient was transported. */
  hospital              String?
  patientName           String?
  patientStateId        String?
  notes                 String?
  /** The formal medical document for this call, by its document number. */
  medicalDocumentNumber String?
  createdByDiscordId    String
  createdByName         String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  responders EmsCallResponder[]

  @@index([occurredAt])
  @@index([patientStateId])
  @@index([createdByDiscordId])
}

model EmsCallResponder {
  id       String @id @default(cuid())
  callId   String
  memberId String
  /** "Lead" for the medic in charge of the patient, otherwise "Responder". */
  role     String @default("Responder")

  call   EmsCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  member Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([callId, memberId])
  @@index([memberId])
}

/// Permanent record of every rank change made through the roster. Written by
/// the member PATCH route whenever it wins a rank change, and never updated or
/// deleted afterwards. memberId is a plain column rather than a relation so a
/// member leaving the roster does not take their history with them — the name,
/// call sign and ranks are copied in at the time of the change.
model PromotionRecord {
  id         String   @id @default(cuid())
  memberId   String?
  memberName String
  callSign   String?
  fromRank   String
  toRank     String
  /// "Promotion" when the new rank weighs more than the old one, "Demotion" otherwise.
  direction  String   @default("Promotion")
  promotedBy String
  promotedAt DateTime @default(now())
  /// The PromotionNotification this was backfilled from, so the backfill script is safe to re-run.
  legacyNotificationId String? @unique
  /// Set when the change came out of a promotion examination rather than a
  /// hand edit on the roster, so Promotion History can show the panel score
  /// and open the interview behind it.
  interviewId          String?
  interviewSessionId   String?
  finalScore           Int?

  @@index([memberId])
  @@index([promotedAt])
}

/// Scoring thresholds and announcement wiring for the Promotion & Interview
/// section. A singleton, like MedicalSettings and NotificationSettings — EMS
/// management edits these rather than a developer editing a constant, which is
/// the whole point of the row existing.
model PromotionSettings {
  id                  String   @id @default("singleton")
  /// Panel score needed to pass, 0-100.
  passingScore        Int      @default(70)
  /// Per-category floors. A panel average below one of these fails the
  /// interview even when the overall score clears passingScore.
  minSopScore         Int      @default(60)
  minMedicalScore     Int      @default(60)
  minSituationScore   Int      @default(60)
  minOverallScore     Int      @default(60)
  /// Eligibility rules, all checked when an interview is created.
  minDaysInRank       Int      @default(14)
  minDaysInDepartment Int      @default(30)
  minTrainingPercent  Int      @default(0)
  /// Departments a candidate must belong to, by DepartmentTemplate name.
  requiredDepartments String[] @default([])
  /// Whether a candidate must be Active on the roster (not Reserve or on LOA).
  requireActive       Boolean  @default(true)
  /// Days a failed candidate waits before another interview may be created.
  cooldownDays        Int      @default(14)
  /// Whether a Lead must tick "training verified" before finalizing.
  requireTrainingCheck Boolean @default(true)
  /// Promotion announcement. Posts to the channel below, falling back to the
  /// shared promotion webhook so an existing deployment announces with nothing
  /// filled in.
  announceWebhook     Boolean  @default(true)
  announcementWebhookUrl String?
  announcementTemplate String  @default("**EMS PROMOTION ANNOUNCEMENT**\n\nCongratulations to <@{discordId}> **{name}** on successfully clearing the EMS Promotion Examination.\n\n**Previous Rank:** {fromRank}\n**New Rank:** {toRank}\n**Final Score:** {finalScore}%\n**Exam Status:** PASSED\n\nThe employee's EMS roster has been updated accordingly.\n\n**Interview Panel:**\n{panel}")
  updatedAt           DateTime @updatedAt @default(now())
  updatedBy           String?
}

/// One promotion examination. The candidate's details are copied in at
/// creation rather than read through a relation, for the same reason
/// PromotionRecord copies them: a member leaving the roster must not take the
/// examination record with them. Never edited after finalizing, and a failed
/// attempt is never reused — a re-interview is a new row.
model PromotionInterview {
  id          String   @id @default(cuid())
  /// EMS-PROMO-2026-0042, from a per-year counter.
  sessionId   String   @unique
  memberId    String?
  memberName  String
  callSign    String?
  discordId   String?
  /// The candidate's rank when the session was created. The finalize step
  /// re-checks the live roster against this before promoting anyone.
  currentRank String
  targetRank  String
  /// Snapshots of the roster dates the eligibility check ran against.
  joinedEmsAt DateTime?
  rankSince   DateTime?
  /// "Ongoing" | "Finalized" | "Cancelled"
  status      String   @default("Ongoing")
  /// "Pending" | "Passed" | "Failed" | "Review Required"
  result      String   @default("Pending")
  /// Panel score at finalize, 0-100. Null while the result is Pending — the
  /// live score is computed from the panel, this is the frozen copy.
  finalScore  Int?
  /// { sop, medical, situation, overall } panel averages at finalize.
  categoryScores Json?
  /// The eligibility verdict as it stood when the session was created:
  /// { eligible: boolean, reasons: string[] }.
  eligibility Json     @default("{}")
  /// Set when the session was created despite failing eligibility.
  eligibilityOverride Boolean @default(false)
  trainingVerified   Boolean   @default(false)
  trainingVerifiedBy String?
  trainingVerifiedAt DateTime?
  /// Set on a failed attempt. Blocks a new interview for this member until it passes.
  cooldownUntil    DateTime?
  /// Management's recommendations for a failed candidate.
  improvementNotes String?
  /// True once the roster rank change went through, so a retry cannot promote twice.
  rosterUpdated    Boolean  @default(false)
  /// The PromotionRecord this examination wrote, when it passed.
  promotionRecordId String?
  /// "Sent" | "Failed" | "Disabled" | "Not applicable", plus the reason.
  announcementStatus String?
  announcementDetail String?
  createdByDiscordId String
  createdByName      String
  finalizedByDiscordId String?
  finalizedByName      String?
  finalizedAt          DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  panel InterviewPanelist[]
  notes InterviewNote[]

  @@index([memberId])
  @@index([status])
  @@index([createdAt])
}

/// One person on an interview panel, with their own evaluation. Scores live
/// here rather than on the interview so no interviewer can overwrite another's
/// assessment — the panel score is the average of these rows.
model InterviewPanelist {
  id          String @id @default(cuid())
  interviewId String
  discordId   String
  name        String
  /// Roster rank at the time they joined the panel, for the panel table.
  rank        String?
  memberId    String?
  /// "Lead Interviewer" | "Interviewer" | "Observer" | "Management Reviewer"
  role        String @default("Interviewer")
  /// 0-100 each, null until scored. An Observer never has any.
  sopScore       Int?
  medicalScore   Int?
  situationScore Int?
  overallScore   Int?
  sopNotes       String?
  medicalNotes   String?
  situationNotes String?
  overallNotes   String?
  /// "Recommend Promotion" | "Do Not Recommend" | "Further Evaluation Required".
  /// Part of the record; it never replaces the finalized result.
  recommendation String?
  /// Set when they submit. A submitted evaluation is what counts toward the panel score.
  submittedAt DateTime?
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interview PromotionInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, discordId])
  @@index([interviewId])
}

/// A general note on an interview. Append-only and one row per note, so
/// several interviewers can record findings without overwriting each other.
model InterviewNote {
  id              String   @id @default(cuid())
  interviewId     String
  authorDiscordId String
  authorName      String
  body            String
  createdAt       DateTime @default(now())

  interview PromotionInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}
