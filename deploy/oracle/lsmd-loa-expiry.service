[Unit]
Description=LSMD nightly LOA expiry job (replaces the Vercel cron)
After=lsmd.service

[Service]
Type=oneshot
User=lsmd
EnvironmentFile=/opt/lsmd/.env
# $$ hands bash a literal $, so the secret is read from the environment rather than spliced in by systemd.
ExecStart=/bin/bash -c 'curl -fsS --max-time 120 -H "Authorization: Bearer $$CRON_SECRET" http://127.0.0.1:3000/api/cron/loa-expiry'
