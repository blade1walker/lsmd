[Unit]
Description=LSMD website (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=lsmd
WorkingDirectory=/opt/lsmd/current
EnvironmentFile=/opt/lsmd/.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# Oracle VMs have no IPv6 route, but some hosts the site calls (Discord, the old
# Neon database during the move) resolve to IPv6 first: without this those
# connections time out (ETIMEDOUT) instead of using IPv4. Node's address racing
# gives IPv4 only 250 ms, under a ~300 ms round trip, then falls through to
# IPv6 and hangs — so it is switched off too.
Environment="NODE_OPTIONS=--dns-result-order=ipv4first --no-network-family-autoselection"
# Only Caddy talks to it; port 3000 is never exposed.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
# The site wins over builds (lsmd-update) on the small VM: its memory is kept
# out of swap and it gets the CPU and disk first.
MemoryLow=400M
CPUWeight=1000
IOWeight=1000

[Install]
WantedBy=multi-user.target
