[Unit]
Description=LSMD website (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=lsmd
WorkingDirectory=/opt/lsmd/current
EnvironmentFile=/opt/lsmd/.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# Oracle VMs have no IPv6 route, but Neon resolves to IPv6 first: without this
# every database connection times out (ETIMEDOUT) instead of using IPv4.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
# Only Caddy talks to it; port 3000 is never exposed.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
