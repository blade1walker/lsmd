# ─── Nexus EMS Bot ──────────────────────────────────────────────────────────
# Copy to .env (or set these in your host's dashboard). Never commit .env.

# Developer Portal → your application → Bot → Reset Token.
DISCORD_TOKEN=""

# The server the bot runs in. Commands register here and appear instantly.
# Discord → User Settings → Advanced → Developer Mode, then right-click the
# server icon → Copy Server ID.
DISCORD_GUILD_ID=""

# The website the bot manages — no trailing slash.
WEBSITE_URL="https://nexis-ems.vercel.app"

# Optional. The bot proves itself to the website with its own Discord token —
# the website checks it belongs to the same Discord application it logs in
# with — so nothing else is needed. Only set this if you also set the same
# NEXUS_BOT_API_KEY on the website (at least 32 characters).
NEXUS_BOT_API_KEY=""

# Timezone that times typed into /announce schedule are read in (IANA name).
TIMEZONE="Asia/Kolkata"

# Optional branding.
BOT_BRAND_NAME="Los Santos EMS"
BOT_LOGO_URL=""

# Optional: a staff channel that receives a log line for every action taken
# through the bot (approvals, promotions, config changes, announcements).
LOG_CHANNEL_ID=""
