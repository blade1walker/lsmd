{
  "name": "nexus-ems-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Nexus EMS Bot — runs the Los Santos EMS website from Discord, and posts and schedules announcements.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "register": "tsx src/register.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
