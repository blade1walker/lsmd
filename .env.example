# Copy to .env and fill in. .env is gitignored — never commit real values.

# PostgreSQL connection string. Required by the app, by `npm run db:push`,
# and by every script under scripts/.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Signs session JWTs. Generate with: openssl rand -base64 32
# Changing it invalidates every existing session.
NEXTAUTH_SECRET=""

# Public URL of the deployment, e.g. https://your-app.vercel.app
# Must match the redirect URI registered in the Discord application.
NEXTAUTH_URL="http://localhost:3000"

# Discord OAuth application credentials (Developer Portal -> your app -> OAuth2)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Bot token, used to send DMs and read Discord usernames. Optional —
# the messaging and recruit-notification features are inert without it.
DISCORD_BOT_TOKEN=""

# Per-category channel webhooks. Each is optional; that category's channel
# post is silently skipped (not an error) when its URL is unset.
DISCORD_ENROLL_WEBHOOK_URL=""
DISCORD_LOA_WEBHOOK_URL=""
DISCORD_ACCEPT_WEBHOOK_URL=""
DISCORD_PROMOTION_WEBHOOK_URL=""
DISCORD_CALLSIGN_WEBHOOK_URL=""
DISCORD_FTP_WEBHOOK_URL=""
# Shared fallback for department join applications. Each department can carry
# its own webhook in the admin panel; this is only used by ones that don't, and
# falls back to DISCORD_FTP_WEBHOOK_URL when it is empty too.
DISCORD_DEPARTMENT_WEBHOOK_URL=""

# Fallback invite link used in outgoing messages when NotificationSettings
# has none configured.
DISCORD_STATE_INVITE=""

# Server (guild) whose member roles the bot manages, and the role granted to
# FTP staff and revoked when a member's category leaves "FTP" (edited or
# removed from the roster). Both required together — DISCORD_BOT_TOKEN alone
# is not enough, since the bot also needs Manage Roles and a role position
# above DISCORD_FTP_ROLE_ID in Server Settings -> Roles. Without these two,
# FTP enrollment still works, just without the Discord role.
DISCORD_GUILD_ID=""
DISCORD_FTP_ROLE_ID=""

# Image uploads in the SOP editor. Provisioned automatically once you enable
# a Blob store: Vercel dashboard -> Storage -> Create Database -> Blob.
# Without it, uploads 503 with that instruction instead of failing silently.
BLOB_READ_WRITE_TOKEN=""

# Shared secret for the nightly LOA job (/api/cron/loa-expiry). Vercel sends it
# as `Authorization: Bearer $CRON_SECRET` for the cron in vercel.json. The route
# refuses to run when this is unset — it edits the roster and sends DMs — so
# leaves stop auto-expiring until you set it. Generate with: openssl rand -hex 32
CRON_SECRET=""
