{
  "name": "nexus-pd-roaster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/deploy-schema.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-roles": "npx tsx scripts/seed-roles.ts",
    "db:backfill-promotions": "npx tsx scripts/backfill-promotion-history.ts",
    "db:grant-permissions": "npx tsx scripts/grant-permissions.ts",
    "db:rename-ranks": "npx tsx scripts/rename-ranks.ts",
    "db:check": "npx tsx scripts/db-check.ts",
    "db:copy": "npx tsx scripts/copy-database.ts",
    "db:radio-codes": "npx tsx scripts/update-radio-codes.ts",
    "db:migrate-sop": "npx tsx scripts/migrate-sop.ts",
    "db:seed-ems-sop": "npx tsx scripts/seed-ems-sop.ts",
    "db:seed-medical-types": "npx tsx scripts/seed-medical-types.ts",
    "lookup-discord-ids": "npx tsx scripts/lookup-discord-ids.ts",
    "db:migrate-ftp-departments": "npx tsx scripts/migrate-ftp-departments.ts",
    "db:reset": "npx prisma db push --force-reset && npm run db:seed",
    "postinstall": "prisma generate && node scripts/deploy-schema.mjs",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
